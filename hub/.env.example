# Grailert hub - example environment. Secrets are intentionally empty.

PORT=3000
DB_PATH=hub.db
FILES_DIR=
MAX_UPLOAD=125829120

# Login password for the UI and cookie-signing secret
HUB_PASSWORD=
HUB_SECRET=

# Shared token for the bots' /hub/stats endpoints
HUB_STATS_TOKEN=
GRAILERT_STATS_URL=http://localhost:8080/hub/stats
# Second product slot ("acme"); empty = not collected
ACME_STATS_URL=

# Telegram: bot tokens used to read channel subscribers and autopost
GRAILERT_BOT_TOKEN=
ACME_BOT_TOKEN=
TG_CHANNEL_GRAILERT=
TG_CHANNEL_ACME=

# Meta Graph API (Instagram / Facebook)
META_TOKEN=
IG_USER_GRAILERT=
IG_USER_ACME=
FB_PAGE_GRAILERT=

COLLECT_EVERY=1800
# Public https URL of the hub (signed file links for Instagram)
PUBLIC_BASE=
