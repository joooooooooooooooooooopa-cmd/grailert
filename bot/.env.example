# Grailert bot - example environment. Copy to .env and fill in.
# Secrets are intentionally empty; numeric values are the code defaults.

# --- Required ----------------------------------------------------------------
BOT_TOKEN=
BOT_USERNAME=your_bot_username
DB_PATH=vinted.db

# --- Payments (Telegram Stars work out of the box; crypto needs Crypto Pay) --
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=
CRYPTOPAY_ASSET=USDT
INVOICE_TTL_SEC=3600

PRICE_BASIC_STARS=500
PRICE_PRO_STARS=999
PRICE_PRO_YEAR_STARS=9990
PRICE_BASIC_USDT=9.99
PRICE_PRO_USDT=19.99
PRICE_PRO_YEAR_USDT=199.0

# --- Access ------------------------------------------------------------------
# Comma-separated Telegram user ids with admin rights
ADMIN_IDS=
# Empty = master key disabled
MASTER_KEY=
INVITE_ONLY=1
INVITE_TRIAL_DAYS=14
INVITE_SEED_KEYS=
KEY_ATTEMPTS_PER_HOUR=5
KEY_SHARE_ALERT_USERS=3
SUPPORT_HANDLE=@your_support

# --- Plans -------------------------------------------------------------------
TRIAL_DAYS=3
REMIND_DAYS_BEFORE=3
LEGACY_GRANT_DAYS=30
REFERRAL_BONUS_DAYS=14

# --- Vinted polling ----------------------------------------------------------
VINTED_PROXY=
VINTED_HOST=vinted.pl
DEFAULT_INTERVAL=120
MIN_INTERVAL=30
PER_PAGE=20
MAX_NOTIFY_PER_POLL=8
REQUEST_GAP=0.8
VINTED_POOL=3
DEAL_RATIO=0.6
DEAL_MIN_SAMPLES=8

# --- Mini App and stats endpoint for the hub ---------------------------------
# Public https URL of this service; empty = Mini App button hidden
APP_URL=
HUB_PORT=8080
HUB_STATS_TOKEN=
CHANNEL_POST_HOUR_UTC=16
